---
import '../styles/global.css';
import content from '../data/content.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Maniáticos Drink · Resto-Bar',
  description = content.es.hero.desc,
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}assets/logo-maniaticos-glass-only.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700&family=Pacifico&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-shell">
      <slot />
    </div>
    <script id="site-content" type="application/json" set:html={JSON.stringify(content)} />
    <script src="../scripts/site.js"></script>
  </body>
</html>
